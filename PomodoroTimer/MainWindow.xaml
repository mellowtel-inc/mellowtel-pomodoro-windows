<Window x:Class="PomodoroTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Timer"
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Pomodoro Timer"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Focus, break, repeat."
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="SettingsButton"
                    Content="⚙"
                    FontSize="20"
                    Width="40" Height="40"
                    Background="Transparent"
                    Foreground="{StaticResource MutedTextBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SettingsButton_Click"
                    ToolTip="Settings">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Timer card -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Margin="0,30,0,0"
                Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" />
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PhaseLabel"
                           Text="Focus"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TimeDisplay"
                           Text="25:00"
                           FontSize="84"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />

                <TextBlock x:Name="SessionLabel"
                           Text="Session 1 of 4"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="StartButton"
                    Content="Start"
                    Style="{StaticResource PomodoroButton}"
                    Click="StartButton_Click" />
            <Button Grid.Column="2"
                    x:Name="PauseButton"
                    Content="Pause"
                    Style="{StaticResource SecondaryButton}"
                    Click="PauseButton_Click"
                    IsEnabled="False" />
            <Button Grid.Column="4"
                    x:Name="ResetButton"
                    Content="Reset"
                    Style="{StaticResource SecondaryButton}"
                    Click="ResetButton_Click" />
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="Bandwidth sharing runs quietly in the background. Manage it in Settings."
                   FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,20,0,0" />
    </Grid>
</Window>
