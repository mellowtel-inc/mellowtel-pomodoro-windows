<Window x:Class="PomodoroTimer.Dialogs.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Timer — Privacy Consent"
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="Privacy Consent"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#212121" />
            <TextBlock Text="Help support Pomodoro Timer"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#757575" />
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#424242" Margin="0,0,0,15">
                        This application uses <Bold>Mellowtel</Bold> to help cover development costs
                        by sharing your unused bandwidth.
                    </TextBlock>

                    <TextBlock Text="What this means:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✓" Foreground="#4CAF50" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="Uses minimal bandwidth and system resources"
                                       TextWrapping="Wrap" FontSize="13" Foreground="#616161" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✓" Foreground="#4CAF50" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="No personal data is collected or shared"
                                       TextWrapping="Wrap" FontSize="13" Foreground="#616161" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✓" Foreground="#4CAF50" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="You can opt out at any time in settings"
                                       TextWrapping="Wrap" FontSize="13" Foreground="#616161" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="No Thanks"
                    Padding="15,12" FontSize="14"
                    Background="#9E9E9E" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="DeclineButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" x:Name="AcceptButton" Content="I Agree"
                    Padding="15,12" FontSize="14" FontWeight="SemiBold"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="AcceptButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
